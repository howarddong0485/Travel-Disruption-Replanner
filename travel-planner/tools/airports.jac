"""OurAirports airport coordinates (public domain), retrieved 2026-11-16.
Source: https://github.com/datasets/airport-codes (large/medium IATA airports).
Source CSV SHA256: b13058a39d558e7787795436c8b0a3d3eb56c1d93dd48082dec960d31cc14cf4
Coordinates locate airports; they are not flight schedules or live flight tracks.
"""
import json;
import gzip;
import base64;
glob AIRPORTS: dict[str, any] = json.loads(gzip.decompress(base64.b64decode("")));

def airport(code: str) -> any {
    data = AIRPORTS.get(code.upper());
    return {"label": code.upper() + " · " + data[0], "lat": data[1], "lon": data[2]} if data else None;
}
