# Copy to .env, enter your free-account keys locally, and load it before starting Jac.
# .env is ignored by Git. Never paste actual credentials into chat or client code.
OPENAI_API_KEY=
BYLLM_DEFAULT_MODEL=gpt-6-luna
# Model settings for conversation, research and structured itinerary drafts.
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_PLANNING_MODEL=gpt-6-luna
LITEAPI_API_KEY=
GEOAPIFY_API_KEY=
# Optional legacy Expedia integration; not needed for LiteAPI or Geoapify.
EXPEDIA_API_KEY=
EXPEDIA_SHARED_SECRET=
# test = Expedia test endpoint; live requires production-approved partner access.
EXPEDIA_ENV=test
